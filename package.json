{
  "name": "nurdle",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@nurdle/*\" run dev",
    "dev:frontend": "pnpm --filter @nurdle/frontend run dev",
    "dev:backend": "pnpm --filter @nurdle/backend run dev",
    "build": "pnpm --filter @nurdle/shared run build && pnpm --parallel --filter \"@nurdle/frontend\" --filter \"@nurdle/backend\" run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --filter @nurdle/backend run test"
  }
}
